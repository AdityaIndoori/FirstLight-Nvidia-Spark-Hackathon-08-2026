# FIRST LIGHT - sample environment
#
# Copy to service/.env and source it, or export these before starting uvicorn.
# There are NO API KEYS anywhere in this file, and that is the point: the box runs
# with the network unplugged. Nothing here reaches out.
#
#   cp .env.example service/.env && set -a && . service/.env && set +a

# ---------------------------------------------------------------- what to serve
# Area of operations. Presets: pinellas | bay | sarasota, or "w,s,e,n" for custom.
# The demo imagery is Panama City, so `bay`.
FIRSTLIGHT_AOI=bay

# Data root: imagery, county datasets, thumbnails, SQLite. Absolute path.
FIRSTLIGHT_DATA=/home/acer01/fl/service/data

# Token for the withheld-image review endpoint. Any non-empty string enables it;
# empty disables review entirely. Not a secret in the cryptographic sense - it
# gates one localhost route on a box in a locked room.
FIRSTLIGHT_REVIEW_TOKEN=demo-review-token

# --------------------------------------------------------------- model endpoints
# Three vLLM servers, all on loopback. Start them before the service; the pipeline
# degrades to labelled stubs rather than failing if one is down.
FIRSTLIGHT_NANO_URL=http://127.0.0.1:8000/v1
FIRSTLIGHT_NANO_MODEL=nano
FIRSTLIGHT_LIGHTNING_URL=http://127.0.0.1:8001/v1
FIRSTLIGHT_LIGHTNING_MODEL=lightning
FIRSTLIGHT_VL_URL=http://127.0.0.1:8002/v1
FIRSTLIGHT_VL_MODEL=captioner

# ------------------------------------------------------------------ measured knobs
# Every default below was chosen from a measurement, not a guess. Change them and
# the latency percentile scopes itself to the new setting rather than averaging the
# old one in - see service/tools/measure_budget.py.

# VL grading calls per tile, and how many run concurrently. Measured: 8 calls at 8
# lanes gives ~11 s per tile end to end; 12 calls gives 13.5 s. The captioner's own
# vLLM server runs --max-num-seqs 4, and the curve flattens at 8 lanes.
FIRSTLIGHT_VL_CALLS_PER_TILE=8
FIRSTLIGHT_VL_CONCURRENCY=8

# Buildings outlined per tile. A real footprint layer puts hundreds under one tile;
# outlining all of them means most carry a labelled stub grade.
FIRSTLIGHT_FOOTPRINTS_PER_TILE=40

# Privacy gate. conf 0.50 measured 98% recall / 86% withhold precision on 50
# held-out person tiles through the tiled path. Lower it and you trade review
# clicks for recall; the eval CLI sweeps it.
FIRSTLIGHT_GATE_CONF=0.50
FIRSTLIGHT_GATE_TILE=1280
FIRSTLIGHT_GATE_OVERLAP=0.20

# Embedder. CPU is PINNED on purpose: with three vLLM pools resident the GPU
# allocator is full and BGE OOMs. Verified.
FIRSTLIGHT_EMBED_DEVICE=cpu
FIRSTLIGHT_EMBED_MODEL=BAAI/bge-small-en-v1.5

# Flight planning: sensor model and airframe. Ground swath is
# 2 * altitude * tan(hfov/2), and sidelap sets lane spacing from it.
FIRSTLIGHT_SURVEY_ALT_M=90
FIRSTLIGHT_SENSOR_HFOV_DEG=76
FIRSTLIGHT_SIDELAP=0.30
FIRSTLIGHT_SURVEY_SPEED_MS=12
FIRSTLIGHT_SURVEY_HALF_M=400

# Dispatch: how close two buildings must be to become one park-up, and the most
# one stop may absorb. Uncapped, absorption is transitive and one "stop" quietly
# became 18 structures across several blocks.
FIRSTLIGHT_STOP_SPACING_M=120
FIRSTLIGHT_STOP_MAX_STRUCTURES=6

# ------------------------------------------------------------------------ offline
# Belt-and-braces only: privacy_gate.py already does os.environ.setdefault, so the
# gate is offline whether or not you set this. Kept here because it documents the
# intent, and because an ultralytics upgrade could drop that default.
YOLO_OFFLINE=true

# NOT required. Verified on this box: the embedder loads from the HF cache in 6.3 s
# with no offline flag set and never touches the network. If you are on a machine
# where sentence-transformers tries a hub lookup, uncomment these.
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1
